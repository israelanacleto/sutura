# Copie este arquivo para application-local.yml (que está no .gitignore) e preencha.
#
#   cp application-local.yml.exemplo application-local.yml
#
# Rode com: mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# ---------------------------------------------------------------------------
# ATENÇÃO AO CAMINHO DA WALLET
# ---------------------------------------------------------------------------
# TNS_ADMIN precisa apontar para a pasta .wallet do SEU clone do repositório. O caminho
# abaixo é um exemplo de uma máquina Windows — troque pelo seu. Use barras normais (/),
# que funcionam nos dois sistemas, e caminho absoluto: o JDBC não resolve caminho relativo
# ao diretório do projeto.
#
#   Windows: F:/PJ/FIAP/Sutura/.wallet
#   Linux:   /home/israel/projetos/sutura/.wallet
#
# A wallet vem do console OCI, em Database connection > Download wallet, descompactada.
# O alias suturadb_high está no tnsnames.ora de dentro dela.

spring:
  datasource:
    url: jdbc:oracle:thin:@suturadb_high?TNS_ADMIN=TROQUE/PELO/CAMINHO/DO/SEU/.wallet
    username: ADMIN
    password: TROQUE_PELA_SENHA_DO_ADMIN

# ---------------------------------------------------------------------------
# Alternativa sem wallet
# ---------------------------------------------------------------------------
# Se o banco tiver sido criado com ACL de rede (lista de IPs permitidos), o console
# oferece uma string de conexão TLS simples, sem wallet, em Database connection >
# Connection strings > TLS. Nesse caso basta:
#
#   url: jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=...))
#
# Com "Secure access from everywhere" sem ACL, como está hoje, só mTLS é oferecido —
# então a wallet é obrigatória.

# ---------------------------------------------------------------------------
# Aviso
# ---------------------------------------------------------------------------
# A senha do ADMIN não vai para o git em hipótese nenhuma: application-local.yml está no
# .gitignore. Para compartilhar com o time, use um canal separado — nunca o repositório,
# nunca o chat do trabalho.
